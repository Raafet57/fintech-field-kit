   photoshop:DateCreated="2023-04-24T00:00:00+00:00"
   photoshop:Credit="Getty Images"
   photoshop:Headline="In the restaurant, a woman uses her smartphone to make a payment with the cashier. She scans the QR code using a card reader to complete a convenient contactless payment. At the same time, the cashier hands over the purchased pizza to the customer."
   photoshop:URL="https://www.istockphoto.com"
   photoshop:Instructions="Model and Property Released (MR&amp;PR) "
   Iptc4xmpCore:CountryCode="TWN"
